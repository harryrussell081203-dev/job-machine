# Copy to .env and fill in. Never commit the real one.

# --- required in production -------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
BASE_URL=https://your-domain.example

# --- where the data lives ---------------------------------------------
# Set DATABASE_URL to a Postgres connection string (Supabase gives one free)
# and the app uses that, ignoring DB_PATH. This is the right answer on any
# host without a disk that survives a deploy - which is every free host.
# Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=

# Used only when DATABASE_URL is empty. Must be on a persistent volume, or
# your customers are deleted by the next deploy.
DB_PATH=/data/jobmachine.db

# --- the app's own outbound mail (sign-in links) ----------------------
APP_SMTP_ADDRESS=
APP_SMTP_PASSWORD=
APP_SMTP_HOST=smtp.gmail.com
APP_SMTP_PORT=465

# --- billing ----------------------------------------------------------
BILLING_ENABLED=1
STRIPE_WEBHOOK_SECRET=
PRICE_LABEL=£9 a month

# EITHER: a Stripe Payment Link, set up in the dashboard. No secret key
# needed - the app never calls the Stripe API, it just sends people to a page
# Stripe hosts. The webhook secret above is still required.
STRIPE_PAYMENT_LINK=

# OR: the API route, which needs both of these instead of the link.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# How long a ONE-OFF payment buys, in days. Ignored for subscriptions.
ONE_OFF_ACCESS_DAYS=30

# --- the job search ----------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
GEMINI_API_KEY=

# handoff = the app drafts, the user sends. See app/delivery.py.
DELIVERY_MODE=handoff

# --- local development only -------------------------------------------
# DEV_MODE=1 prints sign-in links to the console instead of emailing them.
# DEV_MODE=1
# BILLING_ENABLED=0
