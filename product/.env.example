# Copy to .env and fill in. Never commit the real one.

# --- required in production -------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
BASE_URL=https://your-domain.example

# --- where the data lives ---------------------------------------------
# Set DATABASE_URL to a Postgres connection string (Supabase gives one free)
# and the app uses that, ignoring DB_PATH. This is the right answer on any
# host without a disk that survives a deploy - which is every free host.
# Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=

# Used only when DATABASE_URL is empty. Must be on a persistent volume, or
# your customers are deleted by the next deploy.
DB_PATH=/data/jobmachine.db

# --- encrypting users' mail passwords ---------------------------------
# Required for automatic sending. Without it the app still runs and still
# writes every letter - it just cannot store the credentials to send them,
# and says so on the setup screen rather than storing them in the clear.
# Any long random value works - your host's "generate a random value"
# button included. Must be at least 24 characters; a short passphrase is
# refused, because that looks like encryption without being any.
# Changing this makes every stored mail password unreadable and every user
# has to reconnect, so keep it somewhere you will not lose it.
CREDENTIAL_KEY=

# --- the app's own outbound mail (sign-in links) ----------------------
# APP_SMTP_ADDRESS is the From address and is required either way.
APP_SMTP_ADDRESS=

# On a free Render web service, outbound ports 25, 465 and 587 are blocked,
# so SMTP cannot work at all - the symptom is a thirty-second hang, not a
# refusal. Set BREVO_API_KEY and sign-in links go over HTTPS instead.
# brevo.com, free tier, 300 a day. Verify APP_SMTP_ADDRESS as a sender first.
BREVO_API_KEY=

# Used only when BREVO_API_KEY is empty. Fine locally and on a paid host.
APP_SMTP_PASSWORD=
APP_SMTP_HOST=smtp.gmail.com
APP_SMTP_PORT=465

# --- billing ----------------------------------------------------------
BILLING_ENABLED=1
STRIPE_WEBHOOK_SECRET=
PRICE_LABEL=£9 a month

# EITHER: a Stripe Payment Link, set up in the dashboard. No secret key
# needed - the app never calls the Stripe API, it just sends people to a page
# Stripe hosts. The webhook secret above is still required.
STRIPE_PAYMENT_LINK=

# OR: the API route, which needs both of these instead of the link.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# How long a ONE-OFF payment buys, in days. Ignored for subscriptions.
ONE_OFF_ACCESS_DAYS=30

# --- the job search ----------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REED_API_KEY=
GEMINI_API_KEY=

# handoff = the app drafts, the user sends. See app/delivery.py.
DELIVERY_MODE=handoff

# --- Recruited sending addresses -------------------------------------
# Optional. Set both and users get a choice: send from their own mailbox, or
# from an address issued here so their own is never used.
#
# A SUBDOMAIN, not the apex. Sending reputation is per-domain, so a bad run by
# one user must not be able to take down the marketing site's mail or the
# sign-in links. mail.recruited.org.uk can be burned and replaced; the apex
# cannot. Verify it with the provider and add their DNS records first.
MANAGED_MAIL_DOMAIN=
# Resend speaks SMTP, so this reuses the same send path as a user's own
# mailbox. Username is the literal string "resend"; the password is the key.
MANAGED_MAIL_KEY=
# MANAGED_MAIL_HOST=smtp.resend.com
# MANAGED_MAIL_PORT=465
# MANAGED_MAIL_USERNAME=resend
# The provider's ceiling, shared across every user. Resend's free tier is 100
# a day. Going over rejects rather than queues, so it is enforced before the
# send instead of discovered from a bounce.
# MANAGED_MAIL_DAILY_CAP=100

# --- who is responsible for the data -----------------------------------
# Shown on /privacy and /terms. UK GDPR requires the controller to be named
# and contactable; leave these blank and the notice names nobody. Not
# hard-coded because a home address in a public repository gets indexed.
CONTROLLER_NAME=
CONTACT_EMAIL=
CONTROLLER_LOCATION=Aberdeen, Scotland

# Set by hand when the terms or the notice change in substance. A notice that
# silently rewrites itself is worse than one out of date - nobody can say
# what they agreed to.
LEGAL_UPDATED=6 September 2026

# --- local development only -------------------------------------------
# DEV_MODE=1 prints sign-in links to the console instead of emailing them.
# DEV_MODE=1
# BILLING_ENABLED=0
